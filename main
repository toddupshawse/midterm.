<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Target Heart Rate Calculator - todups0860</title>
    <link rel="stylesheet" href="style.css" />
    <script>
        function calculateTHR() {
            let age = document.getElementById("ageInput").value;
            age = Number(age);

            if (age < 0 || age > 125 || isNaN(age)) {
                alert("Please enter a valid age between 0 and 125.");
                return;
            }

            let maxHR = 220 - age;
            let minTHR = Math.floor(maxHR * 0.5);
            let maxTHR = Math.floor(maxHR * 0.85);

            document.getElementById("result").innerHTML =
                "Target Heart Rate: " + minTHR + " - " + maxTHR + " BPM";
        }
    </script>
</head>
<body>
    <div class="container">
        <h1>Target Heart Rate Calculator</h1>
        <h3>Student: Todd Maurice Upshaw (todups0860)</h3>

        <label for="ageInput">Enter Your Age:</label>
        <input type="text" id="ageInput" placeholder="e.g., 25" />

        <button onclick="calculateTHR()">Calculate</button>

        <h2 id="result">Target Heart Rate:</h2>
    </div>
</body>
</html>

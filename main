  <title>Target Heart Rate Calculator | Todd Upshaw</title>

  <!-- Link to CSS -->
  <link rel="stylesheet" href="style.css" />

  <script type="text/javascript">
    function calcHeartRate() {
      var age = document.getElementById("ageInput").value;
      age = parseInt(age);

      // Validate age input
      if (isNaN(age) || age < 0 || age > 125) {
        alert("Please enter a valid age between 0 and 125.");
        return;
      }

      // Calculate values
      var maxHR = 220 - age;
      var minTHR = Math.floor(maxHR * 0.5);
      var maxTHR = Math.floor(maxHR * 0.85);

      // Display result
      document.getElementById("output").textContent =
        "Target Heart Rate: " + minTHR + " to " + maxTHR + " Beats Per Minute";
    }
  </script>
</head>

<body>

  <div class="container">
    <h1>Target Heart Rate Calculator</h1>
    <h2 class="sub">By: Todd Upshaw (Student ID: todups0860)</h2>

    <div class="card">
      <label for="ageInput">Your Age:</label>
      <input type="text" id="ageInput" placeholder="Enter your age..." />

      <button onclick="calcHeartRate()">Calculate Target Heart Rate</button>

      <p id="output" class="result">Target Heart Rate:</p>
    </div>
  </div>

</body>

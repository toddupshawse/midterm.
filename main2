/* General Page Style */
body {
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(135deg, #1e5799, #2989d8, #207cca, #7db9e8);
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #fff;
}

/* Centered Container */
.container {
  text-align: center;
  width: 90%;
  max-width: 450px;
}

/* Heading */
h1 {
  margin-bottom: 5px;
  font-size: 28px;
}

.sub {
  margin-top: 0;
  font-size: 16px;
  opacity: 0.9;
}

/* Card Styling */
.card {
  background: #ffffff;
  color: #000;
  padding: 25px;
  border-radius: 12px;
  box-shadow: 0px 8px 25px rgba(0,0,0,0.25);
  margin-top: 20px;
}

/* Label */
label {
  font-size: 16px;
  font-weight: bold;
}

/* Input Box */
input[type="text"] {
  width: 100%;
  padding: 10px;
  margin: 12px 0;
  border: 2px solid #2989d8;
  border-radius: 8px;
  font-size: 16px;
}

/* Button Styling */
button {
  width: 100%;
  padding: 12px;
  background: #207cca;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 18px;
  cursor: pointer;
  transition: 0.3s ease;
}

button:hover {
  background: #155a96;
}

/* Result Text */
.result {
  margin-top: 20px;
  font-size: 18px;
  font-weight: bold;
}
